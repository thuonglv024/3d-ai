a:["$","$c",null,{"fallback":["$","div",null,{"className":"fit-lazy","children":"Đang tải sản phẩm MORPH Studio…"}],"children":["$","$L19",null,{"product":{"id":"ao-thun-essential","slug":"ao-thun-essential","name":"Áo thun Essential Cotton","subtitle":"Thiết kế kinh điển với phom suông nhẹ và bề mặt chải kỹ mịn màng.","category":"ao-thun","categoryName":"Áo thun","price":390000,"originalPrice":450000,"color":"Trắng ngà","colors":[{"name":"Trắng ngà","hex":"#f4f1ea"},{"name":"Đen tuyền","hex":"#1f2220"},{"name":"Xanh forest","hex":"#194e3d"}],"sizes":["XS","S","M","L","XL"],"image":"/products/ao-thun-essential.jpg","gallery":["/products/ao-thun-essential.jpg"],"description":"Áo thun cổ tròn tối giản dệt từ sợi cotton 100% chải kỹ 240gsm. Thiết kế vừa vặn tự nhiên, vai hơi hạ, mang lại cảm giác thoải mái khi mặc cả ngày.","material":"100% Cotton chải kỹ 240gsm, xử lý wash sinh học chống co rút và xù lông.","fit":"Regular fit vừa vặn, suông nhẹ từ ngực xuống gấu áo.","details":["Bo cổ dày 2.5cm chống giãn sau nhiều lần giặt","Đường may móc xích đôi gia cố vai và sườn áo","Thoáng khí và thấm hút mồ hôi tối ưu","Sản phẩm mẫu thử nghiệm trong MORPH Studio"],"isFeatured":true,"chart":{"name":"Bảng size Áo thun Essential","garment":"top","source":"illustrative","measurement_basis":"body_cm","rows":[{"size":"XS","chest_cm":{"min":72,"max":82},"waist_cm":{"min":60,"max":74}},{"size":"S","chest_cm":{"min":82,"max":90},"waist_cm":{"min":66,"max":80}},{"size":"M","chest_cm":{"min":90,"max":98},"waist_cm":{"min":74,"max":88}},{"size":"L","chest_cm":{"min":98,"max":106},"waist_cm":{"min":82,"max":96}},{"size":"XL","chest_cm":{"min":106,"max":115},"waist_cm":{"min":90,"max":106}}]}}}]}]
